PORT=4000
UI_ORIGIN=http://127.0.0.1:5173
SEED_REQUESTER_A_PASSWORD=replace-with-a-unique-local-synthetic-password
SEED_REQUESTER_B_PASSWORD=replace-with-a-unique-local-synthetic-password
SEED_REVIEWER_R_PASSWORD=replace-with-a-unique-local-synthetic-password
SEED_REVIEWER_S_PASSWORD=replace-with-a-unique-local-synthetic-password
