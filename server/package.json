{
  "name": "@workflow-approval/server",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test": "tsx scripts/run-tests.ts",
    "db:migrate": "tsx scripts/run-prisma.ts migrate deploy",
    "predb:seed": "npm run prisma:generate",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "tsx scripts/run-prisma.ts generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "prisma": "7.10.0"
  }
}
