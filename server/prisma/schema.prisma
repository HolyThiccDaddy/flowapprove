generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  REQUESTER
  REVIEWER
}

enum RequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DecisionAction {
  APPROVE
  REJECT
}

enum RequestEventType {
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  displayName        String    @map("display_name") @db.VarChar(120)
  email              String    @unique @db.VarChar(254)
  passwordHash       String    @map("password_hash")
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  defaultReviewerId  String?   @map("default_reviewer_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  defaultReviewer    User?     @relation("RequesterReviewer", fields: [defaultReviewerId], references: [id], onDelete: Restrict)
  mappedRequesters   User[]    @relation("RequesterReviewer")
  sessions           Session[]
  ownedRequests      Request[] @relation("RequestRequester")
  assignedRequests   Request[] @relation("RequestReviewer")
  decisions          Decision[] @relation("DecisionReviewer")
  events             RequestEvent[] @relation("EventActor")

  @@index([defaultReviewerId])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  csrfToken String    @map("csrf_token") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Request {
  id                 String        @id @default(uuid()) @db.Uuid
  requesterId        String        @map("requester_id") @db.Uuid
  assignedReviewerId String        @map("assigned_reviewer_id") @db.Uuid
  title              String        @db.VarChar(120)
  purpose            String        @db.VarChar(2000)
  estimatedAmount    Decimal       @map("estimated_amount") @db.Decimal(12, 2)
  currency           String        @default("THB") @db.Char(3)
  status             RequestStatus @default(PENDING_REVIEW)
  version            Int           @default(0)
  submittedAt        DateTime      @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  requester          User          @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedReviewer   User          @relation("RequestReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  decision           Decision?
  events             RequestEvent[]

  @@index([requesterId, submittedAt(sort: Desc), id(sort: Desc)])
  @@index([assignedReviewerId, status, submittedAt(sort: Desc), id(sort: Desc)])
  @@map("requests")
}

model Decision {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @unique @map("request_id") @db.Uuid
  reviewerId String         @map("reviewer_id") @db.Uuid
  action     DecisionAction
  reason     String?        @db.VarChar(1000)
  decidedAt  DateTime       @default(now()) @map("decided_at") @db.Timestamptz(6)
  request    Request        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  reviewer   User           @relation("DecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId, decidedAt])
  @@map("decisions")
}

model RequestEvent {
  id         String           @id @default(uuid()) @db.Uuid
  requestId  String           @map("request_id") @db.Uuid
  actorId    String           @map("actor_id") @db.Uuid
  eventType  RequestEventType @map("event_type")
  fromStatus RequestStatus?   @map("from_status")
  toStatus   RequestStatus    @map("to_status")
  reason     String?          @db.VarChar(1000)
  occurredAt DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  request    Request          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor      User             @relation("EventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, occurredAt, id])
  @@map("request_events")
}
